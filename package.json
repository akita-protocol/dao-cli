{
  "name": "@akita-protocol/dao-cli",
  "version": "0.2.0",
  "description": "Read-only CLI and TUI for querying Akita DAO state on Algorand",
  "type": "module",
  "bin": {
    "akita-dao": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "style-screenshots": "bun run scripts/style-screenshots.ts"
  },
  "dependencies": {
    "@akita-protocol/sdk": "1.4.12",
    "@algorandfoundation/algokit-utils": "10.0.0-beta.1",
    "algosdk": "^3.6.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0"
  },
  "files": [
    "src/",
    "images/*_styled.png",
    "install.sh"
  ],
  "keywords": [
    "algorand",
    "dao",
    "akita",
    "akta",
    "cli",
    "tui"
  ],
  "author": "Kyle Breeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akita-protocol/dao-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
